def palidrom(s):
    char_count = {}
    for char in s:
        char_count[char] = char_count.get(char, 0) + 1

    length = 0
    has_odd = False


    for count in char_count.values():

        length += (count // 2) * 2

        if count % 2 == 1:
            has_odd = True


    if has_odd:
        length += 1

    return length


