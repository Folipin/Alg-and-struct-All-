graph["Технологический институт"] = list(
    set(graph["Технологический институт"] + graph.get("Технологический институт 2", [])))
if "Технологический институт 2" in graph:
    del graph["Технологический институт 2"]
for node in graph:
    if "Технологический институт 2" in graph[node]:
        graph[node].remove("Технологический институт 2")
        if "Технологический институт" not in graph[node]:
            graph[node].append("Технологический институт")


def bfs(start, end):
    if start not in graph or end not in graph:
        return None
    queue = deque([[start]])
    visited = {start}

    while queue:
        path = queue.popleft()
        node = path[-1]
        if node == end:
            return path
        for neighbor in graph.get(node, []):
            if neighbor not in visited:
                visited.add(neighbor)
                new_path = list(path)
                new_path.append(neighbor)
                queue.append(new_path)
    return None

def dfs(start, end, path=None, visited=None):
    if path is None:
        path = [start]
    if visited is None:
        visited = set()
    visited.add(start)
    if start == end:
        return path
    for neighbor in graph.get(start, []):
        if neighbor not in visited:
            new_path = dfs(neighbor, end, path + [neighbor], visited)
            if new_path:
                return new_path
    return None


