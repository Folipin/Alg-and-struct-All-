}

def add_edge(u, v):
    if u in graph:
        if v not in graph[u]: graph[u].append(v)
    if v in graph:
        if u not in graph[v]: graph[v].append(u)

add_edge("Невский проспект", "Гостиный двор")
add_edge("Гостиный двор", "Невский проспект")
add_edge("Площадь Восстания", "Маяковская")
add_edge("Маяковская", "Площадь Восстания")
add_edge("Сенная площадь", "Спасская")
add_edge("Спасская", "Сенная площадь")
add_edge("Сенная площадь", "Садовая")
add_edge("Садовая", "Сенная площадь")
